# MongoDB Atlas connection string (Database > Connect > Drivers > Node.js)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Optional, defaults to "reachout". The "leads" collection is created on first submission.
MONGODB_DB=reachout

# Password login (both roles)
ADMIN_PASSWORD=
CLIENT_PASSWORD=
ADMIN_SESSION_SECRET=
# 32 random bytes, base64 encoded (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=
TOKEN_KEY_VERSION=v1

# Meta connection (optional; the site starts without it)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Optional fallback for the Meta sync client.
META_SYSTEM_USER_TOKEN=

# Turnstile (optional; set TURNSTILE_ENABLED=true to use it)
TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cron / site origin / uploads
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=
MAX_UPLOAD_MB=20
