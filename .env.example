# MongoDB Atlas connection string (Database > Connect > Drivers > Node.js)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Optional, defaults to "reachout". The "leads" collection is created on first submission.
MONGODB_DB=reachout

# Authentication / roles
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit callbacks; otherwise derived from the request origin.
GOOGLE_REDIRECT_URI=
OWNER_EMAILS=
CLIENT_EMAILS=
ADMIN_SESSION_SECRET=
# Optional break-glass owner password login; leave disabled in normal operation.
BREAKGLASS_LOGIN_ENABLED=false
ADMIN_PASSWORD=

# Meta connection
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# 32 random bytes, base64 encoded (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=
TOKEN_KEY_VERSION=v1
# Optional fallback for the Meta sync client.
META_SYSTEM_USER_TOKEN=

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cron / site origin / uploads
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=
MAX_UPLOAD_MB=20

